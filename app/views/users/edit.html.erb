<div class="container">
  <div class="d-flex justify-content-center">
    <div class="col-5">
      <h1 class="mt-3">User info</h1>

       <div>
         <% if @user.errors.any? %>
           <h4>
           <%= @user.errors.count %>error prohibited this obj from being saved:
           </h4>
           <ul>
             <% @user.errors.full_messages.each do |message| %>
               <li><%= message %></li>
              <% end %>
            </ul>
         <% end %>
       </div>

      <%= form_with model: @user do |f| %>

        <%= f.label 'Name' %><br>
        <%= f.text_field :name, class: "from-control w-100" %>
        <div class="my-2">
          <%= f.label 'Image' %><br>
          <%= f.file_field :profile_image, accept: "image/*" %>
        </div>
        <%= f.label 'Introduction' %><br>
        <%= f.text_area :introduction, class: "from-control w-100" %>
     
        <div class="mt-2">
          <%= f.submit 'Update User', class: "btn btn-secondary" %>
        </div>
      <% end %>

    </div>
  </div>
</div>