<div class="container">
  <div class="row justify-content-center">
    <div class="col-3">
      <%= render 'books/list', user: @user, book: @book %>
    </div>

    <div class="col-8">
    <h2>Books</h2>

    <table>
      <tr>
        <th>title</th>
        <th>Opinion</th>
        <th colspan="4"></th>
      </tr>
     <% @books.each do |book| %>
      <tr>
        <td><%= image_tag @user.get_profile_image(100,100) %></td>
        <td><%= link_to book.title, book_path(book.id) %></td>
        <td><%= book.body %></td>
      </tr>
      <% end %>
    </table>
  </div>
</div>