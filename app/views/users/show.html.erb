<div class="container">
  <div class="row">
    
<h2>User info</h2>
<%= image_tag @user.get_profile_image(100,100) %>

<div class="row botrder-top border-bottom">
<h5>name</h5>
<%= @user.name %>
</div>

<h5>introduction</h5>
<%= @user.introduction %>

<%= link_to edit_user_path(@user), class: "btn btn-outline-dark col-3" do %>
    <i class="fa-solid fa-user-gear"></i>
<% end %>

<h2>New book</h2>

  <%= form_with model: @book do |f| %>
    <%= f.label :Title %>
    <%= f.text_field :title %>

    <%= f.label :Opinion %>
    <%= f.text_field :body %>

    <%= f.submit 'Create Book' %>

  <% end %>
</div>

<div class=""
<h2>Users</h2>

<table>
  <tr>
    <th>image</th>
    <th>name</th>
    <th colspan="3"></th>
  </tr>
  <% @books.each do |book| %>
  <tr>
    <td><%= book.image %></td>
    <td><%= book.user.name %></td>
    <td><%= link_to 'show', book_path(book.id) %></td>
  </tr>
<% end %>
