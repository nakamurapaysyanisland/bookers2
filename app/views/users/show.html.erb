<div class="container pt-1"> 
  <div class="row"> 
    
    <div class="col-md-3">
      <%= render 'books/list', user: @user, book: @book %>
    </div>

    <div class="col-md-8 offset-md-1 pt-2">
      <h2>Books</h2>

      <table class="table"> 
        <thead>
          <tr class="border-top border-bottom"> 
            <th style="width: 20%"></th>
            <th style="width: 30%">Title</th>
            <th style="width: 50%">Opinion</th>
            <th colspan="3"></th>
          </tr>
        </thead>
        <tbody>
          <% @books.each do |book| %>
          <tr class="border-bottom">
            <td>
              <%= link_to user_path(book.user) do %>
             
                <%= image_tag book.user.get_profile_image(75, 75) %>
              <% end %>
            </td>
            <td><%= link_to book.title, book_path(book.id) %></td>
            <td><%= book.body %></td>
          </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  </div>
</div>
