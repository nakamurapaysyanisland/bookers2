<div class="container pt-1">
  <div class="row">
    <div class="col-md-3">
      <%= render 'list', user: @user, book: @book %>
    </div>
    
    <div class="col-md-8 offset-md-1 pt-2">
      <h2>Book detail</h2>
      <table class="table">
        <tr>
          <td class="d-flex flex-column">
            <%= link_to user_path(@book.user) do %>
              <%= image_tag @book.user.get_profile_image(100,100) %>
            <% end %>
            <%= link_to @book.user.name, user_path(@user) %>
          </td>
          <td style="width: 25%"><%= link_to @book.title, book_path(@book) %></td>
          <td style="width: 30%"><%= @book.body %></td>
          <div style="width: 30%">
          <% if @book.user == current_user %>
            <td><%= link_to 'Edit', edit_book_path(@book), class: "btn btn-danger btn-sm text-light" %></td>
            <td><%= link_to 'Destroy', book_path(@book), method: :delete, data: { confirm: 'Are you sure?' }, class: "btn btn-success btn-sm text-light" %></td>
          <% end %>
          </div>
        </tr>
      </table>
    </div>
  </div>
</div>
