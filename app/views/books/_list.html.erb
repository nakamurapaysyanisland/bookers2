<h2 class="mt-2">User info</h2>
<div class="mb-3">
  <%= image_tag user.get_profile_image(100,100), class: "shadow-sm" %>
</div>

<table class="table">
  <tbody>
    <tr>
      <th class="border-top">name</th>
      <td class="border-top"><%= user.name %></td>
    </tr>
    <tr>
      <th>introduction</th>
      <td><%= user.introduction %></td>
    </tr>
  </tbody>
</table>

<div class="row">
  <%= link_to edit_user_path(user), class: "btn btn-outline-secondary btn-block" do %>
    <i class="fas fa-user-gear"></i>
  <% end %>
</div>

<h2 class="mt-4">New book</h2>

<%= form_with model: book, local: true do |f| %>
  <div class="form-group">
    <%= f.label :title, "Title" %>
    <%= f.text_field :title, class: "form-control border-secondary" %>
  </div>

  <div class="form-group">
    <%= f.label :body, "Opinion" %>
    <%= f.text_area :body, class: "form-control border-secondary" %>
  </div>
  
  <div class="form-group">
    <%= f.submit 'Create Book', class: "btn btn-success" %>
  </div>
<% end %>
