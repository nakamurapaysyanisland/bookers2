      <h2>User info</h2>
        <%= image_tag @user.get_profile_image(100,100) %>
      <div class="botrder-top border-bottom">
        <h5>name</h5>
        <%= @user.name %>
      </div>
      
      <h5>introduction</h5>
      <%= @user.introduction %>
      <%= link_to edit_user_path(@user), class: "btn btn-sm" do %>
        <i class="fa-solid fa-user-gear"></i>
      <% end %>

      <h2>New book</h2>

      <%= form_with model: book do |f| %>
        <%= f.label :Title %><br>
        <%= f.text_field :title %><br>

        <%= f.label :Opinion %><br>
        <%= f.text_field :body %>

        <%= f.submit 'Create Book' %>

      <% end %>
