 <div class="container mr-3">     
      <h2 class="mt-3">User info</h2>
        <%= image_tag @user.get_profile_image(100,100) %>
      <div class="border-top border-bottom">
        <div class="row form-control-lg">
          <div class="w-50 ml-1">
            <h5>name</h5>
          </div>
          <div class="w-25">
           <spanclass="font-weight-bold"><%= @user.name %></span>
          </div>
        </div>
      </div>
      <div class="h-75">
        <h5>introduction</h5>
        <%= @user.introduction %>
      </div>

      <div class="my-2">
        <%= link_to edit_user_path(@user), class: "btn btn-outline-secondary btn-sm w-100" do %>
          <i class="fa-solid fa-user-gear"></i>
        <% end %>
      </div>

      <h2>New book</h2>

      <%= form_with model: book do |f| %>
        <%= f.label :Title %><br>
        <%= f.text_field :title %><br>

        <%= f.label :Opinion %><br>
        <%= f.text_field :body %>
        
        <%= f.submit 'Create Book', class: "btn btn-success mt-2" %>

      <% end %>
</div>