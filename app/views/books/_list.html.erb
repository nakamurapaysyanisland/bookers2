   
 <div class="container mr-auto">
         
      <h2 class="mt-3">User info</h2>
        <%= image_tag @user.get_profile_image(100,100) %>
      <div class="border-top">
      <div class="row form-control-lg h-auto">
          <div class="w-50">
            <h6>name</h6>
          </div>
          <div class="w-50">
           <h6><%= @user.name %></h6>
          </div>
      </div>
      </div>
      <div class="h-100 mb-5 border-top">
        <div class="row form-control-lg h-auto">
          <div class="w-50">
            <h6>introduction</h6>
          </div>
          <div class="w-50">
            <h6><%= @user.introduction %></h6>
          </div>
        </div>
      </div>

      <div class="mt-1">
        <%= link_to edit_user_path(@user), class: "btn btn-outline-secondary btn-sm w-100" do %>
          <i class="fa-solid fa-user-gear"></i>
        <% end %>
      </div>

      <h2 class="mt-3">New book</h2>

      <%= form_with model: @book_new do |f| %>

        <%= f.label :Title %><br>
        <%= f.text_field :title, class: "form-control form-control-sm w-100 border-secondary" %><br>

        <%= f.label :Opinion %><br>
        <%= f.text_area :body, class: "form-control custom-height border-secondary" %>
        
        <%= f.submit 'Create Book', class: "btn btn-success mt-2" %>

      <% end %>
</div>