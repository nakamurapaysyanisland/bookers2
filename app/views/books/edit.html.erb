<div class="container">
  <div class="">
    <h1>Editing Book</h1>

    <%= form_with model: @book, local: true do |f| %>
        <%= f.label 'Title' %>
        <%= f.text_field :title %>

        <div class="my-2">
          <%= f.label 'Opinion' %>
          <%= f.text_field :body %>
        </div>

        <div class="mb-2">
          <%= f.submit 'Update Book' %>
        </div>   
    <% end %>
    <%= link_to 'Show', book_path(@book) %> |
    <%= link_to 'Back', books_path %>
  </div>
</div>