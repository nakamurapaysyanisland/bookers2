<div class="container">
  <div class="d-flex justify-content-center">
    <div class="col-lg-5">
      <h1 class="mt-3">Editing Book</h1>
      <div>
        <% if @book.errors.any? %>
          <h4>
            <%= @book.errors.count %>error prohibited this obj from being saved:
          </h4>
          <ul>
            <% @book.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        <% end %>
      </div>

      <%= form_with model: @book, local: true do |f| %>
        <%= f.label 'Title' %><br>
        <%= f.text_field :title, class: "from-control w-100" %>

        <div class="my-2">
          <%= f.label 'Opinion' %><br>
          <%= f.text_area :body, class: "from-control w-100", rows: "3" %>
        </div>

        <div class="mb-2">
          <%= f.submit 'Update Book', class: "btn btn-success" %>
        </div>   
      <% end %>
      <%= link_to 'Show', book_path(@book) %> |
      <%= link_to 'Back', books_path %>
    </div>
  </div>
</div>