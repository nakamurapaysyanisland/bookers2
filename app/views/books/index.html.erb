<div class="container pt-1">
<div class="mt-1">
  <% if @book_new.errors.any? %>
    <h4>
      <%= @book_new.errors.count %>errors prohibited this obj from being saved:
    </h4>  
    <ul>
      <% @book_new.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
</div>
  <div class="row">
    <div class="col-md-3">
      <%= render 'list', user: @user, book: @book_new %>
    </div>
    <div class="col-md-8 offset-md-1 pt-2">
      <h2>Books</h2>
      <table class="table">
        <tr class="border-top border-bottom">
          <th style="width: 10%"></th>
          <th style="width: 25%">Title</th>
          <th style="width: 65%">Opinion</th>
          <th colspan="3"></th>
        </tr>
        <% @books.each do |book| %>
        <tr class="border-bottom">
          <td>
            <%= link_to user_path(@user) do %>
              <%= image_tag book.user.get_profile_image(75,75) %>
            <% end %>    
          </td>
          <td><%= link_to book.title, book_path(book) %></td>
          </tr>
        <% end %>
      </table>
    
  </div>
</div>
